# No API key needed — this project runs entirely locally via Ollama.
# Install Ollama from https://ollama.com, then:
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
#   ollama serve
#
# Copy this file to .env only if you need to change a default below.

# Swap models without touching code (must be pulled locally first)
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# Only change this if Ollama runs on a different host/port
OLLAMA_HOST=http://localhost:11434
